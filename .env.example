# ════════════════════════════════════════════════════════════
# WhatsApp Selfbot Configuration
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Bot Identity ────────────────────────────────────────────
BOT_NUMBER=628xxx
PREFIX=.

# ── Authorization ───────────────────────────────────────────
# Comma-separated list of numbers allowed to use commands
AUTHORIZED_NUMBERS=628xxx

# Numbers allowed to use >> (eval) and $ (exec) — OWNER ONLY
RCE_NUMBERS=628xxxx

# ── API Keys ────────────────────────────────────────────────
APIKEY=sk-xxx
FISH_APIKEY=sk-xxx
GH_TOKEN=ghp_xxxx

# ── Channels ────────────────────────────────────────────────
CHANNEL=120xxx@newsletter

# ── Sticker Metadata ────────────────────────────────────────
STICKER_PACKNAME=Your Pack Name
STICKER_AUTHOR=Your Name

# ── Features (true/false) ───────────────────────────────────
AUTO_DOWNLOAD=true
AUTO_READ=false
ALWAYS_ONLINE=true
TYPING_INDICATOR=true
ANTI_DELETE=true
AUTO_REJECT_CALL=true

# ── Whitelist ───────────────────────────────────────────────
# Comma-separated list of numbers allowed to call without rejection
CALL_WHITELIST=628xxx

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_SAVE_TO_FILE=false
